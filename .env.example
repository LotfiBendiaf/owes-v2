DATABASE_URL="postgresql://USER:PASSWORD@HOST/owes?sslmode=require"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Required in production to activate verification and recovery email delivery.
RESEND_API_KEY=""
EMAIL_FROM="OWES <noreply@example.com>"
# Optional override for the importer:
LEGACY_DB_PATH="/absolute/path/to/old/OWES/db.sqlite3"
